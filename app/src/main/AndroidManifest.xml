<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keeps the CPU awake during long local jobs (performance test now; backup/sync later
         through WorkManager, which needs it too). Install-time permission, no user prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".app.LekasApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Lekas"
        tools:targetApi="36">

        <activity
            android:name=".ui.sell.SellActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported only to holders of DUMP (adb shell) so scripted perf runs work on release
             builds; other apps cannot start it. The app opens it internally. -->
        <activity
            android:name=".ui.diag.DiagnosticsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:label="@string/diag_title" />
    </application>
</manifest>
