<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keeps the CPU awake during long local jobs (performance test now; backup/sync later
         through WorkManager, which needs it too). Install-time permission, no user prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bluetooth receipt printers and serial scanners, chosen from paired devices only
         (D-027): no discovery, so no location or scan permission on any Android version. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Optional camera barcode scanning (D-025). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".app.LekasApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Lekas"
        tools:targetApi="36">

        <activity
            android:name=".ui.sell.SellActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.products.ProductListActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.products.ProductEditActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.catalog.CategoriesActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ui.catalog.TaxRatesActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ui.sales.SalesActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.sales.SaleDetailActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ui.sales.RefundActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ui.settings.StoreSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.settings.PrinterSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.settings.ScannerSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ui.settings.AuditLogActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ui.scan.CameraScanActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />

        <!-- Exported only to holders of DUMP (adb shell) so scripted perf runs work on release
             builds; other apps cannot start it. The app opens it internally. -->
        <activity
            android:name=".ui.diag.DiagnosticsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:label="@string/diag_title" />

        <!-- Shared receipts (picture/PDF) leave the app only as content:// URIs with a
             one-off read grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
