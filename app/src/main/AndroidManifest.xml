<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keeps the CPU awake during long local jobs (the performance test; backup, sync and update
         checks through WorkManager, which needs it too). Install-time permission, no user prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- WorkManager asks for this; no job here runs as a foreground service (2026-10 review: an
         unused permission the privacy policy did not explain). Its "run at startup" permission stays:
         the daily backup, sync and update checks resume after the phone restarts. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Bluetooth receipt printers and serial scanners, chosen from paired devices only
         (D-027): no discovery, so no location or scan permission on any Android version. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Sync between tills through the store's Google Drive app folder (D-045); selling never
         needs the network. Network state lets WorkManager wait for a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Updates from the app's own GitHub releases (D-059): Android's installer asks the user to
         confirm each one (and, on Android 8+, once to allow LekasPOS to install apps). A Google
         Play build must leave this out (Play updates it; Play does not allow self-updates). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Optional camera barcode scanning (D-025). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".app.LekasApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
