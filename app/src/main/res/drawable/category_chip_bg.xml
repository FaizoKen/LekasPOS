<?xml version="1.0" encoding="utf-8"?>
<!-- A category chip on the tool row's band (tool_row_bg): white with an outline like the buttons beside it, filled
     brand when chosen. Drawn 48dp high inside a 56dp touch target. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#221B7F5B">
    <item
        android:bottom="4dp"
        android:top="4dp">
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/brand" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/tool_row_line" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
