<?xml version="1.0" encoding="utf-8"?>
<!-- The Menu button on the brand bar: a darker box like the pills beside it, so it reads as a button and not
     as a caption (2026-10-13). Drawn 48dp high inside its 56dp touch target. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item
        android:bottom="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/brand_dark" />
        </shape>
    </item>
</ripple>
