<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme (API 21+): no AppCompat/Material Components (D-002).
         Everything is in the Base themes; Theme.Lekas and Theme.Lekas.Dialog only add what one
         API level needs (values-v29: no force dark — the app is light only). -->
    <style name="Base.Theme.Lekas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonStyle">@style/Widget.Lekas.Button</item>
        <item name="android:alertDialogTheme">@style/Theme.Lekas.Dialog</item>
    </style>

    <style name="Theme.Lekas" parent="Base.Theme.Lekas" />

    <style name="Base.Theme.Lekas.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
    </style>

    <style name="Theme.Lekas.Dialog" parent="Base.Theme.Lekas.Dialog" />

    <style name="Widget.Lekas.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Our button shapes have no padding of their own: without some, a label at a large font size
         ran into the edges and broke inside a word or a number. -->
    <style name="Widget.Lekas.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.Lekas.Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/secondary_button_text</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="Widget.Lekas.Button.Danger">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- A word that acts without the weight of a button: Cancel, Back, Split payment (the payment, D-064). -->
    <style name="Widget.Lekas.Button.Text">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Keypad keys: big digits, no minimum width (4 across on a small phone). -->
    <style name="Widget.Lekas.Key" parent="Widget.Lekas.Button.Secondary">
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Lekas.Toggle" parent="Widget.Lekas.Button">
        <item name="android:background">@drawable/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:minWidth">0dp</item>
        <!-- The shape background has no padding of its own: without this the label touches (and
             on tablets was clipped at) the edges. -->
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- Small buttons on the selected bill line (remove, −, +, more): 56dp tall, no minimum width. -->
    <style name="Widget.Lekas.Button.Line" parent="Widget.Lekas.Button.Secondary">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Lekas.Button.LineDanger" parent="Widget.Lekas.Button.Line">
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- Selling screen tool: an icon over a word, so nobody has to guess what it does (D-049).
         At least 56dp high, taller when a large font puts the word on two lines. -->
    <style name="Widget.Lekas.Tool" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">60dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/icon_toggle_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Lekas.ToolIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/brand</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Text.Lekas.ToolLabel" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Lekas.IconButton" parent="android:Widget.Material.ImageButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_secondary</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Widget.Lekas.TopIcon" parent="Widget.Lekas.IconButton">
        <item name="android:tint">@color/text_on_brand</item>
    </style>

    <style name="Text.Lekas.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Lekas.Caption" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Lekas.Label" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Lekas.Section" parent="android:TextAppearance.Material.Body2">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Lekas.Display" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Lekas.Tag" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Lekas.Empty" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">32dp</item>
        <item name="android:layout_gravity">center</item>
    </style>
</resources>
