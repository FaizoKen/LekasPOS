<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme (API 21+): no AppCompat/Material Components (D-002). -->
    <style name="Theme.Lekas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonStyle">@style/Widget.Lekas.Button</item>
    </style>

    <style name="Widget.Lekas.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Lekas.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="Text.Lekas.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Lekas.Caption" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
