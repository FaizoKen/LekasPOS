<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme (API 21+): no AppCompat/Material Components (D-002). -->
    <style name="Theme.Lekas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonStyle">@style/Widget.Lekas.Button</item>
        <item name="android:alertDialogTheme">@style/Theme.Lekas.Dialog</item>
    </style>

    <style name="Theme.Lekas.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
    </style>

    <style name="Widget.Lekas.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Lekas.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="Widget.Lekas.Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/secondary_button_text</item>
    </style>

    <style name="Widget.Lekas.Button.Danger">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- Keypad keys: big digits, no minimum width (4 across on a small phone). -->
    <style name="Widget.Lekas.Key" parent="Widget.Lekas.Button.Secondary">
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Lekas.Toggle" parent="Widget.Lekas.Button">
        <item name="android:background">@drawable/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:minWidth">0dp</item>
        <!-- The shape background has no padding of its own: without this the label touches (and
             on tablets was clipped at) the edges. -->
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Widget.Lekas.IconButton" parent="android:Widget.Material.ImageButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_secondary</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Widget.Lekas.TopIcon" parent="Widget.Lekas.IconButton">
        <item name="android:tint">@color/text_on_brand</item>
    </style>

    <style name="Text.Lekas.Body" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Lekas.Caption" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Lekas.Label" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Lekas.Section" parent="android:TextAppearance.Material.Body2">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Lekas.Display" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Lekas.Tag" parent="android:TextAppearance.Material.Caption">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Lekas.Empty" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">32dp</item>
        <item name="android:layout_gravity">center</item>
    </style>
</resources>
