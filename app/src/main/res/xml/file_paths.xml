<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Files shared to other apps: cache/shared/<kind>/ (receipt, csv, backup); files older than
         15 minutes are deleted when the next one is shared (CsvFiles.sharedFile). -->
    <cache-path
        name="shared"
        path="shared/" />
    <!-- A downloaded update, read by Android's installer (AppUpdates, D-059). -->
    <files-path
        name="updates"
        path="updates/" />
</paths>
