<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/app_name"
        android:textColor="@color/text_on_brand"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/staff_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="140dp"
        android:minHeight="40dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:minHeight="32dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/printer_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:minHeight="32dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_camera"
        style="@style/Widget.Lekas.TopIcon"
        android:layout_width="52dp"
        android:layout_height="56dp"
        android:contentDescription="@string/sell_camera"
        android:src="@drawable/ic_camera"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/btn_held"
            style="@style/Widget.Lekas.TopIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/held_title"
            android:src="@drawable/ic_held" />

        <TextView
            android:id="@+id/held_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/text_on_brand"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_menu"
        style="@style/Widget.Lekas.TopIcon"
        android:layout_width="52dp"
        android:layout_height="56dp"
        android:contentDescription="@string/sell_menu"
        android:src="@drawable/ic_more" />
</LinearLayout>
