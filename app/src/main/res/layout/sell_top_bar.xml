<?xml version="1.0" encoding="utf-8"?>
<!-- Store name, who is selling, and pills that appear only when there is something to see
     (held bills, printer, backup). Every control has a word, not just an icon (D-049). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/app_name"
        android:textColor="@color/text_on_brand"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/staff_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_info_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="120dp"
        android:minHeight="40dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/held_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_info_bg"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/printer_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/btn_menu"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/sell_menu"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="56dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            style="@style/Widget.Lekas.ToolIcon"
            android:src="@drawable/ic_more"
            android:tint="@color/text_on_brand" />

        <TextView
            style="@style/Text.Lekas.ToolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/sell_menu"
            android:textColor="@color/text_on_brand" />
    </LinearLayout>
</LinearLayout>
