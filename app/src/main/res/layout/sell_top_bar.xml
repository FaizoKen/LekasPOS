<?xml version="1.0" encoding="utf-8"?>
<!-- Store name, who is selling, and pills that appear only when there is something to see
     (held bills, printer, backup, a new version). Every control has a word, not just an icon (D-049).
     TopBarLayout: first child = the name, last child = Menu (always top right); pills that do
     not fit beside the name move to a line below (small phones). -->
<com.lekaspos.ui.sell.TopBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/app_name"
        android:textColor="@color/text_on_brand"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/staff_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_info_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="120dp"
        android:minHeight="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/held_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_info_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/printer_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- A manager helping with this bill (D-063): their buttons show; a tap ends it. -->
    <TextView
        android:id="@+id/helper_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_info_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="200dp"
        android:minHeight="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- A new version of the app is ready (D-059): shown to whoever may change settings. -->
    <TextView
        android:id="@+id/update_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_info_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="@color/text_on_brand"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Menu: a pill like the others on the bar (same height, corners and colour), its icon beside the word. The
         darker box of 1.17.0's test build did not match the pills beside it (the owner, 2026-10-13). -->
    <LinearLayout
        android:id="@+id/btn_menu"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:background="@drawable/pill_info_bg"
        android:clickable="true"
        android:contentDescription="@string/sell_menu"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="56dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_more"
            android:tint="@color/text_on_brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:text="@string/sell_menu"
            android:textColor="@color/text_on_brand"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.lekaspos.ui.sell.TopBarLayout>
