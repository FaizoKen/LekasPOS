<?xml version="1.0" encoding="utf-8"?>
<!-- Under a customer's balance (CustomerActivity): a repayment, and the other actions. The balance itself was
     the way to them when tapped, with nothing to show it (2026-10-13). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:baselineAligned="false"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <Button
        android:id="@+id/customer_receive"
        style="@style/Widget.Lekas.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:minWidth="0dp" />

    <Button
        android:id="@+id/customer_more"
        style="@style/Widget.Lekas.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:minWidth="0dp" />
</LinearLayout>
