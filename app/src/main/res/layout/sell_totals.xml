<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/totals_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- chip_bg draws the chip 48dp high inside this 56dp touch target. -->
    <TextView
        android:id="@+id/customer_chip"
        style="@style/Text.Lekas.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/chip_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:visibility="gone" />

    <!-- "3 items · discount …" on a line of its own: beside the total it squeezed the total out
         at large font sizes. -->
    <TextView
        android:id="@+id/summary"
        style="@style/Text.Lekas.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="14sp" />

    <!-- The bill's total in big figures; it shrinks rather than lose a digit. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            style="@style/Text.Lekas.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/sell_total"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <com.lekaspos.ui.common.FitTextView
            android:id="@+id/total"
            style="@style/Text.Lekas.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="end"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.lekaspos.ui.common.FitButton
            android:id="@+id/btn_hold"
            style="@style/Widget.Lekas.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sell_hold" />

        <com.lekaspos.ui.common.FitButton
            android:id="@+id/btn_discount"
            style="@style/Widget.Lekas.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/sell_discount" />

        <com.lekaspos.ui.common.FitButton
            android:id="@+id/btn_pay"
            style="@style/Widget.Lekas.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1.6"
            android:minHeight="64dp"
            android:text="@string/sell_pay_empty"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
