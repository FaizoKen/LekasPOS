<?xml version="1.0" encoding="utf-8"?>
<!-- The sale's result on a screen held sideways (D-063): the change and the receipt on the left, the
     buttons stacked on the right — "New sale" fell below a phone's short height. Same ids as
     dialog_result (upright). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/result_label"
            style="@style/Text.Lekas.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <!-- One line that shrinks: a change amount split over two lines was misread. -->
        <com.lekaspos.ui.common.FitTextView
            android:id="@+id/result_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/brand"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result_received"
            style="@style/Text.Lekas.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result_receipt"
            style="@style/Text.Lekas.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/result_print_state"
            style="@style/Text.Lekas.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/result_customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result_low_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/warning"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Button
            android:id="@+id/result_new"
            style="@style/Widget.Lekas.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/result_new"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/result_print"
                style="@style/Widget.Lekas.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/result_share"
                style="@style/Widget.Lekas.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/result_share" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
