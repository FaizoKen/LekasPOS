<?xml version="1.0" encoding="utf-8"?>
<!-- Payment, top to bottom in the order a cashier needs it (D-049): the total, what the customer
     gave and the change, one-tap cash notes, every payment method, then the keypad for other
     amounts. The buttons stay above the keypad so a small phone never hides them. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <!-- The label keeps its room; the amount takes the rest and shrinks rather than wrap. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Lekas.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/pay_total"
                android:textSize="18sp" />

            <com.lekaspos.ui.common.FitTextView
                android:id="@+id/pay_total"
                style="@style/Text.Lekas.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pay_tenders"
            style="@style/Text.Lekas.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pay_remaining_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/Text.Lekas.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pay_remaining"
                android:textSize="16sp" />

            <com.lekaspos.ui.common.FitTextView
                android:id="@+id/pay_remaining"
                style="@style/Text.Lekas.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/pay_cash_hint"
            style="@style/Text.Lekas.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:visibility="gone" />

        <TextView
            style="@style/Text.Lekas.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pay_received" />

        <com.lekaspos.ui.common.FitTextView
            android:id="@+id/pay_amount"
            style="@style/Text.Lekas.Display"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/field_bg"
            android:gravity="end|center_vertical"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <com.lekaspos.ui.common.FitTextView
            android:id="@+id/pay_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/change_bg"
            android:gravity="end|center_vertical"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pay_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/pay_methods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/pay_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/pay_keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
