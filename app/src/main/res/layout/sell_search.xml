<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/field_bg"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:hint="@string/sell_search_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:minHeight="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/search_clear"
        style="@style/Widget.Lekas.IconButton"
        android:layout_width="48dp"
        android:layout_height="52dp"
        android:contentDescription="@string/clear"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_other"
        style="@style/Widget.Lekas.IconButton"
        android:layout_width="52dp"
        android:layout_height="56dp"
        android:contentDescription="@string/other_item_title"
        android:src="@drawable/ic_add" />

    <ImageButton
        android:id="@+id/btn_browse"
        style="@style/Widget.Lekas.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/icon_toggle_bg"
        android:contentDescription="@string/sell_browse"
        android:src="@drawable/ic_grid" />
</LinearLayout>
