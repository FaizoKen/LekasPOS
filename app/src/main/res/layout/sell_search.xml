<?xml version="1.0" encoding="utf-8"?>
<!-- One row above the tiles: a Search button, the category chips (All, Popular, the shop's categories), the camera
     scanner (two panes; on a phone upright it is inside the open box), then labelled tools: Price check, and Items (phones; two-pane screens always show the items). Search
     opens the box in the chips' place until the search is done (the owner, 2026-10-13: the chips had a row of
     their own under the box and took the tiles' room). Only registered products are sold (D-050): an unknown
     barcode is registered first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tool_row_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/btn_search"
        style="@style/Widget.Lekas.Tool"
        android:contentDescription="@string/sell_search_hint">

        <ImageView
            style="@style/Widget.Lekas.ToolIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_search" />

        <TextView
            style="@style/Text.Lekas.ToolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="96dp"
            android:maxLines="2"
            android:text="@string/sell_search_hint_short" />
    </LinearLayout>

    <com.lekaspos.ui.common.TapList
        android:id="@+id/category_list"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="0dp"
        android:paddingEnd="4dp" />

    <LinearLayout
        android:id="@+id/search_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:addStatesFromChildren="true"
        android:background="@drawable/field_bg"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="@string/sell_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:singleLine="true" />

        <!-- Phones upright: the camera is here, the row has no room for it beside the chips. -->
        <ImageButton
            android:id="@+id/btn_camera_box"
            style="@style/Widget.Lekas.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/sell_camera"
            android:src="@drawable/ic_camera"
            android:tint="@color/brand"
            android:visibility="gone" />

        <!-- Closes the search (the text with it): the chips come back. -->
        <ImageButton
            android:id="@+id/search_clear"
            style="@style/Widget.Lekas.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Two panes (tablets, phones sideways): the camera in the row, open search or not. -->
    <ImageButton
        android:id="@+id/btn_camera"
        style="@style/Widget.Lekas.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/sell_camera"
        android:src="@drawable/ic_camera"
        android:tint="@color/brand"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/btn_price_check"
        style="@style/Widget.Lekas.Tool"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/price_check_title">

        <ImageView
            style="@style/Widget.Lekas.ToolIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_tag" />

        <TextView
            style="@style/Text.Lekas.ToolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="96dp"
            android:maxLines="2"
            android:text="@string/price_check_title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_browse"
        style="@style/Widget.Lekas.Tool"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/sell_browse">

        <ImageView
            style="@style/Widget.Lekas.ToolIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_grid" />

        <TextView
            style="@style/Text.Lekas.ToolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="96dp"
            android:maxLines="2"
            android:text="@string/sell_tool_items" />
    </LinearLayout>
</LinearLayout>
