<?xml version="1.0" encoding="utf-8"?>
<!-- Search or scan, with the camera scanner inside the box, then labelled tools: Price check,
     and Items (phones; two-pane screens always show the items). Only registered products are
     sold (D-050): an unknown barcode is registered first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/search_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:addStatesFromChildren="true"
        android:background="@drawable/field_bg"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="@string/sell_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/search_clear"
            style="@style/Widget.Lekas.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_camera"
            style="@style/Widget.Lekas.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/sell_camera"
            android:src="@drawable/ic_camera"
            android:tint="@color/brand"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_price_check"
        style="@style/Widget.Lekas.Tool"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/price_check_title">

        <ImageView
            style="@style/Widget.Lekas.ToolIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_tag" />

        <TextView
            style="@style/Text.Lekas.ToolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="96dp"
            android:maxLines="2"
            android:text="@string/price_check_title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_browse"
        style="@style/Widget.Lekas.Tool"
        android:contentDescription="@string/sell_browse">

        <ImageView
            style="@style/Widget.Lekas.ToolIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_grid" />

        <TextView
            style="@style/Text.Lekas.ToolLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="96dp"
            android:maxLines="2"
            android:text="@string/sell_tool_items" />
    </LinearLayout>
</LinearLayout>
