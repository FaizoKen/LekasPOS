<?xml version="1.0" encoding="utf-8"?>
<!-- One bill line. The selected line (the one just scanned or tapped) shows its buttons right
     here: −, quantity, + and remove, more (D-049). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/Text.Lekas.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/detail"
                style="@style/Text.Lekas.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Shrinks before it takes all of the name's room (large fonts, narrow bill pane). -->
        <com.lekaspos.ui.common.FitTextView
            android:id="@+id/amount"
            style="@style/Text.Lekas.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxWidth="128dp"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Two rows, so "More" (line discount, price change) never falls off a narrow bill pane or a
         large font: − quantity + first, then Remove and More. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/line_qty_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/line_minus"
                style="@style/Widget.Lekas.Button.Line"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:contentDescription="@string/line_minus"
                android:scaleType="center"
                android:src="@drawable/ic_minus"
                android:tint="@color/brand" />

            <com.lekaspos.ui.common.FitButton
                android:id="@+id/line_qty"
                style="@style/Widget.Lekas.Button.Line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/line_plus"
                style="@style/Widget.Lekas.Button.Line"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:contentDescription="@string/line_plus"
                android:scaleType="center"
                android:src="@drawable/ic_add"
                android:tint="@color/brand" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.lekaspos.ui.common.FitButton
                android:id="@+id/line_remove"
                style="@style/Widget.Lekas.Button.LineDanger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/line_remove_short" />

            <com.lekaspos.ui.common.FitButton
                android:id="@+id/line_more"
                style="@style/Widget.Lekas.Button.Line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/line_more" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
